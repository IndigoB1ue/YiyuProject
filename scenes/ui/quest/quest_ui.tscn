[connection signal="pressed" from="OpenButton" to="." method="open_quests"]
[connection signal="pressed" from="Tracker/Content/Header/Collapse" to="." method="_on_collapse_pressed"]
[connection signal="pressed" from="Tracker/Content/TrackerBody/Actions/TrackerList" to="." method="open_quests"]
[connection signal="pressed" from="Tracker/Content/TrackerBody/Actions/SkipTutorial" to="." method="_on_skip_pressed"]
[connection signal="pressed" from="Overlay/Canvas/Frame/Content/Header/Close" to="." method="close_quests"]
[connection signal="pressed" from="Overlay/Canvas/Frame/Content/Columns/ListColumn/Filters/ActiveTab" to="." method="_set_filter" binds=[false]]
[connection signal="pressed" from="Overlay/Canvas/Frame/Content/Columns/ListColumn/Filters/CompletedTab" to="." method="_set_filter" binds=[true]]
[connection signal="pressed" from="Overlay/Canvas/Frame/Content/Columns/Details/TrackButton" to="." method="_on_track_pressed"]
